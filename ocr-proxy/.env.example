# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง — อย่า commit .env เข้า git
# ขอ API key ฟรีที่ https://opentyphoon.ai (Playground > API Keys)
TYPHOON_API_KEY=

# โดเมนของหน้าเว็บที่อนุญาตให้เรียก คั่นด้วยจุลภาค
# ตอนพัฒนาใช้ http://localhost:8080 ตอนขึ้นจริงใส่โดเมนจริง
# ปล่อยเป็น * ได้เฉพาะตอนทดสอบ ห้ามใช้บน production
ALLOWED_ORIGINS=http://localhost:8080

# จำกัดอัตรารวมทั้ง server — ตั้งตามโควตาที่ Typhoon ให้ (2 req/s, 20 req/min)
RATE_PER_SECOND=2
RATE_PER_MINUTE=20

# จำกัดอัตราแยกตาม IP — กันคนเดียวยิงรัวจนคนอื่นใช้ไม่ได้
# ตั้งต่ำกว่าค่ารวมข้างบนเสมอ ไม่งั้นจะไม่มีผลอะไร
RATE_PER_IP_SECOND=1
RATE_PER_IP_MINUTE=6

# ตั้งเป็น 1 เฉพาะเมื่อมี nginx / Cloudflare อยู่ข้างหน้าจริง ๆ
# ถ้าเปิดทั้งที่เปิดตรงสู่อินเทอร์เน็ต ใครก็ปลอม X-Forwarded-For เพื่อหนีการจำกัดอัตราได้
TRUST_PROXY=0

# ขนาดภาพสูงสุดที่รับ (MB) — วัดจากขนาดภาพจริงหลังถอด base64
MAX_IMAGE_MB=6

# รอ Typhoon นานสุดกี่มิลลิวินาที เกินแล้วตอบ 504 แทนที่จะค้างไว้
TYPHOON_TIMEOUT_MS=60000

# ใช้เมื่อ self-host โมเดลเอง เช่น http://localhost:8101/v1
# TYPHOON_BASE_URL=
# TYPHOON_MODEL=typhoon-ocr
